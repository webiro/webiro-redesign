<div class="wp-content">
<section class="l-section wpb_row height_medium with_img parallax_ver parallaxdir_reversed"><div class="l-section-img" role="img" data-img-width="" data-img-height="" style="background-image: url(https://webiro.ir/wp-content/uploads/2025/02/serviceListBack.svg);"></div><div class="l-section-h i-cf"><div class="g-cols vc_row via_flex valign_top type_default stacking_default"><div class="vc_col-sm-12 wpb_column vc_column_container"><div class="vc_column-inner"><div class="wpb_wrapper">[vc_custom_heading text=&#8221;خدمات برنامه‌نویسی در یک نگاه&#8221; font_container=&#8221;tag:h1|font_size:28px|text_align:center|color:%23160b0b&#8221; use_theme_fonts=&#8221;yes&#8221;][vc_raw_html][/vc_raw_html]<div class="w-html"><style>
a.wbSlides__Item.paragraph__Lh {
    backdrop-filter:blur(5px)
}
.grid_Services {
    display: grid;
    grid-template-columns: repeat(12,1fr);
    gap: 10px;
    justify-content: center;
}

.about_servicePages_Slider .wbSlides__Item:not(.empty),.grid_Services .wbSlides__Item:not(.empty) {
    border: 1px solid #dbdbdb;
    text-align: center;
    padding: 1rem;
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-size: var(--fz-md);
    font-weight: var(--fw-600);
    color: var(--black);
    transition: var(--transition);
    border-radius: var(--border-radius-sm);
    aspect-ratio: 1;
    grid-column: auto / span 2;
    background-color: var(--white);
}

.grid_Services .wbSlides__Item:not(.empty):hover {
    background-color: #f2f2f2;
    border-color: #292727;
}

.grid_Services .wbSlides__Item.empty {
    border: none;
}

.grid_Services .wbSlides__Item.empty:nth-child(1) {
    grid-area: 1/1/2/5;
}

.grid_Services .wbSlides__Item.empty:nth-child(2) {
    grid-area: 1/10/2/13;
}

.grid_Services .wbSlides__Item.empty.near-last {
    grid-area: 3/1/4/5;
}

.grid_Services .wbSlides__Item.empty.last {
    grid-area: 4/10/4/13;
}

@media (max-width: 1200px) and (min-width:992px) {
    .about_servicePages_Slider .wbSlides__Item,.grid_Services .wbSlides__Item {
        grid-template-columns:repeat(6,1fr);
    }

    .grid_Services .wbSlides__Item.empty:nth-child(1),.grid_Services .wbSlides__Item.empty:nth-child(2) {
        display: none;
    }
}

@media (max-width: 991px) {
    .grid_Services {
        grid-template-columns:repeat(4,1fr);
    }

    .grid_Services .wbSlides__Item.empty {
        display: none !important;
    }
}

@media (min-width: 992px) {
    @property --start {
        syntax:"<number>";
        inherits: true;
        initial-value: 0;
    }

    .grid_Services {
        --spread: 60;
        margin-bottom: 2rem;
    }

    :is(.home__ServiceList_Wrapper,.about__ServiceList_Wrapper ) .wbSlides__Item {
        border: none !important;
        --active: 0.15;
        --start: 0;
        transition: none !important;
        position: relative;
    }

    :is(.home__ServiceList_Wrapper,.about__ServiceList_Wrapper ) .wbSlides__Item:not(.empty):hover {
        border-color: none !important;
        background-color: #fff !important;
    }

    :is(.home__ServiceList_Wrapper,.about__ServiceList_Wrapper ) .wbSlides__Item:not(.empty)::before {
        position: absolute;
        inset: 0;
        border: 2px solid transparent;
        content: "";
        border-radius: var(--border-radius-sm);
        pointer-events: none;
        background: #dbdbdb;
        background-attachment: fixed;
        -webkit-mask: linear-gradient(#0000,#0000),conic-gradient(hsl(0 0% 86% / 0.3),hsl(0 0% 86% / 0.3));
        mask: linear-gradient(#0000,#0000),conic-gradient(hsl(0 0% 86% / 0.3),hsl(0 0% 86% / 0.3));
        mask-clip: padding-box,border-box;
        mask-composite: intersect;
        opacity: 1;
        transition: opacity 1s;
    }

    .wbSlides__Item:not(.empty)::after {
        --bg-size: 100%;
        content: "";
        pointer-events: none;
        position: absolute;
        background: conic-gradient(from 180deg at 50% 70%,hsla(0,0%,98%,1) 0deg,#000 72.0000010728836deg,#0f0f0f 144.0000021457672deg,#222222 216.00000858306885deg,#323232 288.0000042915344deg,hsla(0,0%,98%,1) 1turn);
        background-attachment: fixed;
        border-radius: var(--border-radius-sm);
        opacity: var(--active,0);
        transition: opacity 1s;
        --alpha: 0;
        inset: 0;
        border: 2px solid transparent;
        -webkit-mask: linear-gradient(#0000,#0000),conic-gradient(from calc(((var(--start) + (var(--spread) * 0.25)) - (var(--spread) * 0.5)) * 1deg),#0000 0deg,#fff,#0000 calc(var(--spread) * 0.5deg));
        mask: linear-gradient(#0000,#0000),conic-gradient(from calc(((var(--start) + (var(--spread) * 0.25)) - (var(--spread) * 0.5)) * 1deg),#0000 0deg,#fff,#0000 calc(var(--spread) * 0.5deg));
        filter: brightness(1.5);
        mask-clip: padding-box,border-box;
        mask-composite: intersect;
    }
}

.grid_Services {
    --blur: 0; /* Default blur value */
    --spread: 0; /* Default spread value */
}

.wbSlides__Item {
    --active: 0; /* Default active state */
    --start: 0; /* Default start angle */
    transition: all 0.3s ease-in-out;
}

section#services i {
    font-size:36px;
    margin-bottom:10px;
}
</style></div><div class="w-html"><script>
$(document).ready(function() {
    const isPhone = window.innerWidth < 992;

    // Handle pointermove event for grid services
    const CONTAINER = document.querySelector(".grid_Services");
    const CARDS = document.querySelectorAll(".wbSlides__Item");
    if (CONTAINER && !isPhone) {
        const CONFIG = {
            proximity: 50,
            spread: 180,
            blur: 40,
            opacity: 0,
        };

        const UPDATE = (event) => {
            for (const CARD of CARDS) {
                const CARD_BOUNDS = CARD.getBoundingClientRect();
                if (
                    event?.x > CARD_BOUNDS.left - CONFIG.proximity &&
                    event?.x < CARD_BOUNDS.left + CARD_BOUNDS.width + CONFIG.proximity &&
                    event?.y > CARD_BOUNDS.top - CONFIG.proximity &&
                    event?.y < CARD_BOUNDS.top + CARD_BOUNDS.height + CONFIG.proximity
                ) {
                    CARD.style.setProperty("--active", 1);
                } else {
                    CARD.style.setProperty("--active", CONFIG.opacity);
                }

                const CARD_CENTER = [CARD_BOUNDS.left + CARD_BOUNDS.width * 0.5, CARD_BOUNDS.top + CARD_BOUNDS.height * 0.5];
                let ANGLE = (Math.atan2(event?.y - CARD_CENTER[1], event?.x - CARD_CENTER[0]) * 180) / Math.PI;
                ANGLE = ANGLE < 0 ? ANGLE + 360 : ANGLE;
                CARD.style.setProperty("--start", ANGLE + 90);
            }
        };

        const RESTYLE = () => {
            CONTAINER.style.setProperty("--blur", CONFIG.blur);
            CONTAINER.style.setProperty("--spread", CONFIG.spread);
        };

        CONTAINER.addEventListener("pointermove", UPDATE);
        RESTYLE();
        UPDATE();
    }

    // Initialize Slick Carousel for services
    $('#services').slick({
        slidesToShow: 3,
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        responsive: [
            {
                breakpoint: 768,
                settings: {
                    slidesToShow: 2,
                },
            },
            {
                breakpoint: 480,
                settings: {
                    slidesToShow: 1,
                },
            },
        ],
    });
});
</script></div></div></div></div></div></div></section>

</div>
