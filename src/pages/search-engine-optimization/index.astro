        mask: linear-gradient(#0000,#0000),conic-gradient(from calc(((var(--start) + (var(--spread) * 0.25)) - (var(--spread) * 0.5)) * 1deg),#0000 0deg,#fff,#0000 calc(var(--spread) * 0.5deg));
